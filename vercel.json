{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "admin/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "ajax/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.{png,ico,json,js}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
