{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php"
    },
    {
      "src": "admin/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "ajax/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
